{
  "name": "WitnessSite",
  "description": "A customer-owned website or product surface that can receive Witness reports.",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "slug": { "type": "string", "minLength": 3, "maxLength": 80 },
    "public_key": {
      "type": "string",
      "minLength": 20,
      "description": "Capability key used by the public report form. Treat as public but rotate it if abused."
    },
    "allowed_origin": {
      "type": "string",
      "format": "uri",
      "description": "Canonical origin that is allowed to embed the reporter experience."
    },
    "capture_enabled": { "type": "boolean", "default": true },
    "retention_days": { "type": "integer", "minimum": 1, "maximum": 3650, "default": 365 },
    "created_by_email": { "type": "string", "format": "email" }
  },
  "required": ["name", "slug", "public_key", "allowed_origin", "created_by_email"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
